<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Configuration\ExchangeSettings.json" />
    <None Remove="Configuration\Referential.json" />
    <None Remove="Configuration\SymbolMapping.json" />
    <None Remove="Resources\XMM_Abi.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configuration\ExchangeSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Configuration\SymbolMapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\Referential.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\XMM_Abi.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GeneticSharp" Version="3.1.4" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Nethereum.ABI" Version="4.20.0" />
    <PackageReference Include="Nethereum.Accounts" Version="4.20.0" />
    <PackageReference Include="Nethereum.BlockchainProcessing" Version="4.20.0" />
    <PackageReference Include="Nethereum.Contracts" Version="4.20.0" />
    <PackageReference Include="Nethereum.Hex" Version="4.20.0" />
    <PackageReference Include="Nethereum.JsonRpc.Client" Version="4.20.0" />
    <PackageReference Include="Nethereum.JsonRpc.RpcClient" Version="4.20.0" />
    <PackageReference Include="Nethereum.KeyStore" Version="4.20.0" />
    <PackageReference Include="Nethereum.Model" Version="4.20.0" />
    <PackageReference Include="Nethereum.RLP" Version="4.20.0" />
    <PackageReference Include="Nethereum.RPC" Version="4.20.0" />
    <PackageReference Include="Nethereum.Signer" Version="4.20.0" />
    <PackageReference Include="Nethereum.Util" Version="4.20.0" />
    <PackageReference Include="Nethereum.Web3" Version="4.20.0" />
  </ItemGroup>

</Project>
