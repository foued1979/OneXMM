<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Configuration\ExchangeSettings.json" />
    <None Remove="Configuration\MySQLSettings.txt" />
    <None Remove="Configuration\NodeSettings.txt" />
    <None Remove="Configuration\Referential.json" />
    <None Remove="Configuration\SymbolMapping.json" />
    <None Remove="Resources\CoinKYCPool.json" />
    <None Remove="Resources\CoinPool.json" />
    <None Remove="Resources\EthKYCPool.json" />
    <None Remove="Resources\EthPool.json" />
    <None Remove="Resources\Token.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configuration\ExchangeSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Configuration\MySQLSettings.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Configuration\NodeSettings.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Configuration\DataSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Configuration\SymbolMapping.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\Referential.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\CoinKYCPool.json" />
    <EmbeddedResource Include="Resources\CoinPool.json" />
    <EmbeddedResource Include="Resources\EthKYCPool.json" />
    <EmbeddedResource Include="Resources\EthPool.json" />
    <EmbeddedResource Include="Resources\Token.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Accord" Version="3.8.0" />
    <PackageReference Include="Accord.Genetic" Version="3.8.0" />
    <PackageReference Include="Accord.Math" Version="3.8.0" />
    <PackageReference Include="Accord.Statistics" Version="3.8.0" />
    <PackageReference Include="GeneticSharp" Version="3.1.4" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MySql.Data" Version="9.3.0" />
    <PackageReference Include="Nethereum.ABI" Version="5.0.0" />
    <PackageReference Include="Nethereum.Accounts" Version="5.0.0" />
    <PackageReference Include="Nethereum.BlockchainProcessing" Version="5.0.0" />
    <PackageReference Include="Nethereum.Contracts" Version="5.0.0" />
    <PackageReference Include="Nethereum.Hex" Version="5.0.0" />
    <PackageReference Include="Nethereum.JsonRpc.Client" Version="5.0.0" />
    <PackageReference Include="Nethereum.JsonRpc.RpcClient" Version="5.0.0" />
    <PackageReference Include="Nethereum.KeyStore" Version="5.0.0" />
    <PackageReference Include="Nethereum.Model" Version="5.0.0" />
    <PackageReference Include="Nethereum.RLP" Version="5.0.0" />
    <PackageReference Include="Nethereum.RPC" Version="5.0.0" />
    <PackageReference Include="Nethereum.Signer" Version="5.0.0" />
    <PackageReference Include="Nethereum.Util" Version="5.0.0" />
    <PackageReference Include="Nethereum.Web3" Version="5.0.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Formatters\" />
  </ItemGroup>

</Project>
